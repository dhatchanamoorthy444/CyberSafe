# ─────────────────────────────────────────────────────────────────────────────
# CyberSafe — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (safe to use in server-side code only)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable / anon key (read-only, row-level security enforced)
# Used ONLY in browser-side code where explicitly required (e.g. auth UI)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key — NEVER expose to the browser
# Used server-side only (Vercel serverless function) for privileged inserts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: restrict CORS to a specific Vercel preview / production URL
# Leave blank to echo the request Origin (same-project deployments)
CORS_ALLOWED_ORIGIN=
