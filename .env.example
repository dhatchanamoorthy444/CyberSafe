# ─────────────────────────────────────────────────────────────────────────────
# CyberSafe — Environment Variables
# Backend (Render) — Copy to Render Settings → Environment
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Database Connection
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-key-here

# Optional: External APIs (Groq, VirusTotal)
GROQ_API_KEY=your-groq-api-key-here
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vercel) — Add in Vercel Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_URL=https://cybersafe-api.onrender.com
